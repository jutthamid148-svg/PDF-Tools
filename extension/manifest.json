{
  "manifest_version": 3,
  "name": "PDF Tool",
  "short_name": "PDF Tool",
  "version": "1.0.0",
  "description": "Quick access to PDF and AI tools directly inside Chrome.",
  "action": {
    "default_title": "Open PDF Tool",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "contextMenus", "activeTab"],
  "commands": {
    "open-pdf-tool": {
      "suggested_key": { "default": "Ctrl+Shift+P", "mac": "MacCtrl+Shift+P" },
      "description": "Open PDF Tool"
    }
  }
}
